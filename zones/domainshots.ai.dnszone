zone:
  name: domainshots.ai
  class: IN
  ttl: 300

serial: auto

soa:
  primary_ns: gdns1.onedns.io
  contact: hostmaster.domainshots.ai
  serial: 1
  refresh: 3600
  retry: 600
  expire: 604800
  negative_ttl: 1800

records:
  '@':
    NS:
      - gdns1.onedns.io
      - gdns2.onedns.io
    A: 129.153.158.177
  'api':
    A: 129.153.158.177
  'app':
    A: 129.153.158.177
  'www':
    A: 129.153.158.177
  'selector1._domainkey':
    CNAME: selector1.domainshots.ai.dkim.iad1.oracleemaildelivery.com
