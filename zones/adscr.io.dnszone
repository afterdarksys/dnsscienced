zone:
  name: adscr.io
  class: IN
  ttl: 300

serial: auto

soa:
  primary_ns: gdns1.onedns.io
  contact: hostmaster.adscr.io
  serial: 1
  refresh: 3600
  retry: 600
  expire: 604800
  negative_ttl: 1800

records:
  '@':
    NS:
      - gdns1.onedns.io
      - gdns2.onedns.io
    A: 108.165.123.229
  '*':
    A: 108.165.123.229
  'www':
    A: 108.165.123.229
  'auth':
    CNAME: registry.afterdarksys.com
  'artifacts':
    A: 108.165.123.229
  '_acme-challenge':
    TXT:
      - 'b4IStvMXAtYYRAS52vXuB4wAhsc21rhMQmtV1Hp_XDE'
      - 'Nhasa1K97Ugkfj5L2tofINJ6LOYogBA7GkU3DMdx7MU'
