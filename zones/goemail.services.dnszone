zone:
  name: goemail.services
  class: IN
  ttl: 300

serial: auto

soa:
  primary_ns: gdns1.onedns.io
  contact: hostmaster.goemail.services
  serial: 1
  refresh: 3600
  retry: 600
  expire: 604800
  negative_ttl: 1800

records:
  '@':
    NS:
      - gdns1.onedns.io
      - gdns2.onedns.io
    A: 108.165.123.229
    MX:
      - priority: 10
        value: relay-b.msgs.global
      - priority: 10
        value: relay-a.msgs.global
  'www':
    A: 108.165.123.229
