zone:
  name: apiproxy.app
  class: IN
  ttl: 300

serial: auto

soa:
  primary_ns: gdns1.onedns.io
  contact: hostmaster.apiproxy.app
  serial: 1
  refresh: 3600
  retry: 600
  expire: 604800
  negative_ttl: 1800

records:
  '@':
    NS:
      - gdns1.onedns.io
      - gdns2.onedns.io
    A: 141.148.21.202
  'api':
    A: 141.148.21.202
  'dashboard':
    A: 141.148.21.202
  'www':
    CNAME: apiproxy.app
