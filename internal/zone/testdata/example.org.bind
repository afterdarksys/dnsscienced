; BIND zone file for example.org
$ORIGIN example.org.
$TTL 3600

; SOA Record
@    IN  SOA  ns1.example.org. hostmaster.example.org. (
                 2024010100  ; Serial
                 7200        ; Refresh (2 hours)
                 3600        ; Retry (1 hour)
                 1209600     ; Expire (2 weeks)
                 3600 )      ; Negative TTL (1 hour)

; Nameservers
     IN  NS   ns1.example.org.
     IN  NS   ns2.example.org.

; Apex records
@    IN  A    198.51.100.1
@    IN  AAAA 2001:db8:100::1
@    IN  MX   10 mail1.example.org.
@    IN  MX   20 mail2.example.org.
@    IN  TXT  "v=spf1 mx -all"

; Web server
www  IN  A    198.51.100.10
www  IN  A    198.51.100.11
www  IN  AAAA 2001:db8:100::10

; FTP is an alias
ftp  IN  CNAME www.example.org.

; Mail servers
mail1  IN  A    198.51.100.20
mail1  IN  AAAA 2001:db8:100::20
mail2  IN  A    198.51.100.21

; Nameserver glue
ns1  IN  A    198.51.100.53
ns1  IN  AAAA 2001:db8:100::53
ns2  IN  A    198.51.100.54

; DMARC record
_dmarc  IN  TXT  "v=DMARC1; p=quarantine; rua=mailto:dmarc@example.org"

; SIP service
_sip._tcp  IN  SRV  10 60 5060 sip1.example.org.
_sip._tcp  IN  SRV  10 40 5060 sip2.example.org.

; Wildcard
*  IN  A  198.51.100.100

; Phase 10: Record Type Expansion test records

; SSHFP record (RFC 4255) — ECDSA SHA-256
host  IN  SSHFP  3 2 a87f1b687ac0e57d2a081a2f282672334d90ed316d2b818ca9580ea384d92401

; NAPTR record (RFC 3403) — SIP E2U
_sip._tcp  IN  NAPTR  100 10 "u" "E2U+sip" "!^.*$!sip:info@example.org!" .

; SMIMEA record (RFC 8162) — DANE-EE SPKI SHA-256
_smimecert._tcp.user  IN  SMIMEA  3 1 1 a87f1b687ac0e57d2a081a2f282672334d90ed316d2b818ca9580ea384d92401

; LOC record (RFC 1876) — MIT campus area
host  IN  LOC  42 21 43.952 N 71 06 18.910 W 24m 30m 10m 2m
